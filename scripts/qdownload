#!/usr/bin/env python3

import os
import sys
import threading
import queue
import subprocess
import time

OUTDIR = os.path.expanduser("~/Documents/.vid")
os.makedirs(OUTDIR, exist_ok=True)

q = queue.Queue()
worker_running = threading.Event()
worker_running.set()

def worker():
    while worker_running.is_set() or not q.empty():
        try:
            url = q.get(timeout=0.2)
        except queue.Empty:
            continue

        subprocess.run(
            [
                "yt-dlp",
                "--quiet",
                "--no-progress",
                "-o", f"{OUTDIR}/%(title)s.%(ext)s",
                url,
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

        q.task_done()

    print(f"ALL DOWNLOADED TO {OUTDIR}")

threading.Thread(target=worker, daemon=True).start()

try:
    for line in sys.stdin:
        url = line.strip()
        if url:
            q.put(url)
except KeyboardInterrupt:
    pass

# Stop accepting input, wait for downloads to finish
worker_running.clear()
q.join()
time.sleep(0.1)
